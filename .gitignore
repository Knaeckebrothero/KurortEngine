# ---------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging — anchored to the repository root so a source
# directory that happens to be named `lib/` or `bin/` is not swallowed.
/bin/
/build/
/develop-eggs/
/dist/
/eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Translations
*.mo
*.pot

# Sphinx documentation
docs/_build/

# Mr Developer
.mr.developer.cfg
.project
.pydevproject

# Rope
.ropeproject

