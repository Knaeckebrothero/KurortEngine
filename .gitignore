# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# NOTE: there is deliberately NO blanket `*.yaml` rule here.
# This repository ships YAML as first-class content:
#   src/kurort_engine/profiles/*.yaml              Satzung profiles, loaded at runtime
#   src/channel_manager_minstay/profiles/*.yaml    MinStay profiles, loaded at runtime
#   spec/*/spec.yaml                               the feature contracts
#   tests/fixtures/**/*.yaml                       test fixtures
# A blanket rule silently excluded all 13 of them, which would have shipped a
# package whose profile_loader finds no profiles. Ignore secrets explicitly
# instead:
*.local.yaml
*.secret.yaml
secrets.yaml

# Local environment
.env

# Virtualenvs — the repository this code was extracted from committed three
# nested .venv trees, 76 MB of a 150 MB total. Never again.
.venv/
venv/
ENV/

# Test / coverage / lint caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.cache
nosetests.xml

# Automation scratch. Tooling runs directly in this tree; the repository this
# code came from accumulated 39 loose scratch files at its root (grep.txt,
# wc.txt, out.txt, diff.txt, result1.txt ...). Root-level .txt is therefore
# ignored by default, with the files we actually want spelled out.
/*.txt
!/LICENSE.txt
!/requirements.txt
!/requirements-dev.txt
.subagents/
.worktrees/
tmp/

# Generated artefacts. `kurort-engine meldeschein` writes ./meldeschein.pdf by
# default; one had been committed in the source repository. The demo writes
# its CSV into demos/out/ — the committed reference copy is the test fixture
# at tests/fixtures/expected_synthetic_bad_orb.csv, not this one.
/meldeschein.pdf
src/kurort_engine/demos/out/

# SQLite database files
*.db

